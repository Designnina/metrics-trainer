#!/bin/bash
# Запуск локального сервера тренажёра и открытие сайта в браузере.
# Двойной клик по этому файлу в Finder запускает всё автоматически.
cd "$(dirname "$0")"

echo "▶ Проверяю зависимости... (может занять минуту при первом запуске)"
if [ ! -d node_modules ]; then
  npm install
fi

echo "▶ Запускаю локальный сервер и открываю браузер..."
npx vite --open /metrics-trainer/ --host

echo ""
echo "Сервер остановлен."
